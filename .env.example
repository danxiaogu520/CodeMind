# Runtime
CODEMIND_ENVIRONMENT=development
CODEMIND_LOG_LEVEL=INFO
CODEMIND_LOG_FORMAT=json
CODEMIND_API_HOST=0.0.0.0
CODEMIND_API_PORT=8000
CODEMIND_POSTGRES_PORT=5432
CODEMIND_QDRANT_HTTP_PORT=6333
CODEMIND_QDRANT_GRPC_PORT=6334

# Infrastructure
CODEMIND_DATABASE_URL=postgresql+asyncpg://codemind:codemind@localhost:5432/codemind
CODEMIND_CHECKPOINT_DATABASE_URL=postgresql://codemind:codemind@localhost:5432/codemind
CODEMIND_QDRANT_URL=http://localhost:6333
CODEMIND_READINESS_TIMEOUT_SECONDS=2.0

# Repository safety (Phase 1)
CODEMIND_REPOSITORY_WORK_DIR=/data/repositories
CODEMIND_ALLOWED_REPOSITORY_ROOTS=[]
CODEMIND_REPOSITORY_MAX_FILE_BYTES=1000000
CODEMIND_GIT_TIMEOUT_SECONDS=120
CODEMIND_GIT_ALLOWED_HOSTS='["github.com", "gitlab.com", "bitbucket.org"]'
# Keep `hash` for deterministic offline tests. The local-model override uses Ollama.
CODEMIND_EMBEDDING_PROVIDER=hash
CODEMIND_EMBEDDING_MODEL=qwen3-embedding:0.6b
CODEMIND_EMBEDDING_BASE_URL=http://localhost:11434
CODEMIND_EMBEDDING_DIMENSIONS=256
CODEMIND_EMBEDDING_TIMEOUT_SECONDS=120
CODEMIND_EMBEDDING_QUERY_INSTRUCTION="Given a software repository question, retrieve relevant source code that answers it."
CODEMIND_VECTOR_COLLECTION_NAME=codemind_code_chunks
CODEMIND_LEXICAL_INDEX_DIR=/data/indexes
CODEMIND_WORKER_POLL_INTERVAL_SECONDS=1

# Hybrid retrieval (Phase 2)
CODEMIND_RETRIEVAL_RECALL_LIMIT=40
CODEMIND_RETRIEVAL_RERANK_LIMIT=30
CODEMIND_RERANKER_TIMEOUT_SECONDS=2
CODEMIND_CONTEXT_TOKEN_BUDGET=6000
CODEMIND_CONTEXT_MAX_EVIDENCE=20
CODEMIND_CONTEXT_MAX_PER_PATH=3
CODEMIND_LLM_PROVIDER=template
CODEMIND_LLM_MODEL=qwen3:8b
CODEMIND_LLM_BASE_URL=http://localhost:11434
CODEMIND_LLM_TIMEOUT_SECONDS=180
CODEMIND_LLM_CONTEXT_WINDOW=8192
CODEMIND_LLM_MAX_OUTPUT_TOKENS=1024
CODEMIND_LLM_FALLBACK_TO_TEMPLATE=true
CODEMIND_AGENT_RESUME_ON_STARTUP=true
# Testing hook for crash-resume verification; keep zero in normal environments.
CODEMIND_AGENT_NODE_DELAY_SECONDS=0
CODEMIND_INDEX_RETAINED_VERSIONS=3
CODEMIND_PARSER_TIMEOUT_SECONDS=30
CODEMIND_INDEX_JOB_STALE_AFTER_SECONDS=120
CODEMIND_INDEX_JOB_MAX_ATTEMPTS=3

# Restrict LangGraph checkpoint deserialization to safe built-in types.
LANGGRAPH_STRICT_MSGPACK=true
